{
  "name": "codeloom",
  "version": "1.0.0",
  "description": "CodeLoom — Private Local AI Coding Assistant. A professional desktop app powered by Ollama and Whisper, running 100% offline.",
  "productName": "CodeLoom",
  "main": "out/main/index.js",
  "author": "Offline Coder",
  "private": true,
  "scripts": {
    "start": "electron-vite dev",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --config.files='out/**/*'",
    "preview": "electron-vite preview",
    "lint": "eslint src --ext .js,.jsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "electron-updater": "^6.1.7",
    "ollama": "^0.5.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.5.0",
    "remark-gfm": "^4.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^33.0.0",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.3.0",
    "jsdom": "^30.0.1",
    "vite": "^5.0.0",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.codeloom.app",
    "productName": "CodeLoom",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true
    },
    "dmg": {
      "title": "CodeLoom",
      "sign": false
    },
    "linux": {
      "target": "AppImage"
    },
    "win": {
      "target": "nsis"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "onnxruntime-node@1.24.3": true,
    "sharp@0.34.5": true,
    "protobufjs@7.6.5": true,
    "fsevents@2.3.3": true
  }
}
